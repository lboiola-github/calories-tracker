# Copiar a .env.local para desarrollo. En Vercel: Settings → Environment Variables.

# Supabase → Project Settings → API. Son públicas (la seguridad la da RLS).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Solo servidor (nunca NEXT_PUBLIC_). Clave gratuita: https://fdc.nal.usda.gov/api-key-signup
# Sin clave se usa DEMO_KEY, que tiene un límite muy bajo.
USDA_API_KEY=
